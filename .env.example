APP_ENV=development
POSTGRES_DB=reslot
POSTGRES_USER=reslot
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# The API uses a restricted login. Only the migration command receives the admin URL.
APP_DATABASE_PASSWORD=replace-with-runtime-password
DATABASE_URL=postgresql+psycopg://reslot_app:replace-with-runtime-password@localhost:5432/reslot
MIGRATION_DATABASE_URL=postgresql+psycopg://reslot:CHANGE_ME_POSTGRES_PASSWORD@localhost:5432/reslot
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

